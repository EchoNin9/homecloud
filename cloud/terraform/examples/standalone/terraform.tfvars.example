# Copy to terraform.tfvars (gitignored).
region   = "us-east-1"
home_ids = ["home"]

# Recommended: the private key is generated on the NAS and never leaves it.
# See docs/first-deploy.md step 2.
device_csr_files = {
  home = "./certs/home.csr"
}

# Daily history rollups split at local midnight for this fixed UTC offset (no DST), e.g. -7.
# history_utc_offset_hours = -7
