# Copy to .env (never commit it).
DATA_ROOT=/volume1/docker/homecloud
# IANA time zone. Match it to history_utc_offset_hours in the cloud tfvars.
TZ=Europe/London

# --- bridge <-> cloud (values come from the cloud module's Terraform outputs) ---
# HOME_ID must match ^[a-z0-9-]{1,32}$. IOT_THING_NAME is {prefix}-{HOME_ID} and is also the MQTT client id.
HOME_ID=my-home
IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.eu-west-1.amazonaws.com
IOT_THING_NAME=homecloud-my-home

# --- Home Assistant ---
HA_URL=ws://127.0.0.1:8123/api/websocket
# Long-lived access token: HA profile page -> Security -> Long-lived access tokens.
HA_TOKEN=replace-me

# --- what the bridge exports / accepts ---
BRIDGE_ALLOWED_DOMAINS=light,switch,sensor,binary_sensor,climate,cover,lock,fan,scene,script,sun,update
# Comma-separated fnmatch globs on entity_id, e.g. light.guest_*,sensor.*_password
BRIDGE_ENTITY_EXCLUDE=sensor.wud_*,binary_sensor.wud_*
# Only these services can ever be called from the cloud.
# lock.unlock (and cover.open_cover on garage doors, alarm_control_panel.*) are deliberately
# NOT default: a compromised cloud account or API key must not be able to unlock a door.
# Add them here only if you accept that, and ideally restrict by BRIDGE_ENTITY_EXCLUDE.
BRIDGE_ALLOWED_SERVICES=light.turn_on,light.turn_off,light.toggle,switch.turn_on,switch.turn_off,switch.toggle,scene.turn_on,climate.set_temperature,cover.open_cover,cover.close_cover,fan.turn_on,fan.turn_off

# --- optional Zigbee (docker compose --profile zigbee up -d) ---
ZIGBEE_DEVICE=/dev/ttyUSB0

# --- optional AdGuard Home (docker compose --profile adguard up -d) ---
# A free LAN IP outside DHCP, on a NIC other than the one holding the NAS's main IP.
ADGUARD_IP=10.0.0.53
ADGUARD_PARENT=eth3
LAN_SUBNET=10.0.0.0/24
LAN_GATEWAY=10.0.0.1

# --- update checker (wud): MQTT user `wud` (docs/synology.md "Upgrading") ---
WUD_MQTT_PASSWORD=replace-me
WUD_ADMIN_PASSWORD=replace-me

# --- backups (the `backup` service runs scripts/backup.sh daily) ---
BACKUP_AT=03:30
BACKUP_KEEP=14
# Upload only works when running backup.sh on the host with the AWS CLI configured.
# BACKUP_S3_URI=s3://my-bucket/homecloud/
